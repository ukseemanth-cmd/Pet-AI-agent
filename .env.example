# ============================================
# PRODUCTIVITY PET — Environment Variables
# ============================================

# --- AI Provider (Backend Only — NEVER expose to frontend) ---
MEMCODE_API_KEY=
MEMCODE_BASE_URL=https://api.memcode.ai/v1
MEMCODE_MODEL=gpt-4o-mini

# --- Database ---
# For Vercel Production: A PostgreSQL connection string (e.g., from Vercel Postgres or Supabase).
# Example: postgresql://user:password@hostname:5432/productivity_pet
# Leave empty for SQLite fallback (default for local development only)
DATABASE_URL=

# --- Backend ---
CORS_ORIGINS=http://localhost:5173
SECRET_KEY=change-me-to-a-random-secret
DEMO_MODE=false

# --- Frontend ---
VITE_API_URL=http://localhost:8000
