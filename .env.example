# ============================================
# PRODUCTIVITY PET — Environment Variables
# ============================================

# --- AI Provider (Backend Only — NEVER expose to frontend) ---
MEMCODE_API_KEY=
MEMCODE_BASE_URL=https://api.memcode.ai/v1
MEMCODE_MODEL=gpt-4o-mini

# --- Database ---
# For PostgreSQL: postgresql://user:password@localhost:5432/productivity_pet
# Leave empty for SQLite fallback (default for local dev)
DATABASE_URL=

# --- Backend ---
CORS_ORIGINS=http://localhost:5173
SECRET_KEY=change-me-to-a-random-secret
DEMO_MODE=false

# --- Frontend (.env in frontend/) ---
# VITE_API_URL=http://localhost:8000
