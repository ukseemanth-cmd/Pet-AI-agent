{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Productivity Pet",
  "version": "1.0.0",
  "identifier": "com.productivitypet.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173/?mode=desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Productivity Pet Desktop Companion",
        "width": 260,
        "height": 340,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
